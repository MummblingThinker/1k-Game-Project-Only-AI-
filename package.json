{
  "name": "ai-take-over",
  "version": "0.3.0",
  "private": true,
  "description": "Fifteen-stage solo and cooperative browser platformer with shared physics, giant robot encounters and original anime comic chapters.",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "check": "node scripts/check-project.mjs",
    "offline": "node server/static-server.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run check && node scripts/revision-test.mjs && node scripts/followup-test.mjs && npm run test:client && npm run smoke",
    "test:rules": "node scripts/rules-test.mjs",
    "test:systems": "node scripts/systems-test.mjs",
    "test:adversarial": "node scripts/adversarial-test.mjs",
    "test:jitter": "node scripts/jitter-test.mjs",
    "test:soak": "node scripts/soak-test.mjs",
    "test:campaign": "node scripts/campaign-test.mjs",
    "test:survivor": "node scripts/last-survivor-test.mjs",
    "test:live-campaign": "node scripts/live-campaign-test.mjs",
    "test:sequence": "node scripts/live-sequence-test.mjs",
    "test:disconnect": "node scripts/disconnect-test.mjs",
    "test:abuse": "node scripts/abuse-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "verify:board": "node scripts/verify-task-board.mjs",
    "test:multiplayer": "node scripts/multiplayer-test.mjs",
    "test:client": "node scripts/network-client-test.mjs",
    "check:submission": "node scripts/check-submission.mjs",
    "test:legacy-contracts": "npm run check && npm run test:rules && npm run test:systems && npm run test:campaign && npm run test:survivor && npm run smoke && npm run verify:board && npm run test:client && npm run test:multiplayer",
    "test:revision": "node scripts/revision-test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
